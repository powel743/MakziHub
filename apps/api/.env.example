# ─────────────────────────────────────────────────────────────
# MakaziHub API (Render) — environment variables
# Every value below is read by the codebase (src/config/env.ts + direct
# process.env reads). Names match the code exactly.
# ─────────────────────────────────────────────────────────────

# ── Database / Supabase ───────────────────────────────────────
# This project uses Supabase (no raw DATABASE_URL).
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Auth ──────────────────────────────────────────────────────
# Must be at least 32 characters.
JWT_SECRET=your_very_long_jwt_secret_at_least_32_chars
# NOTE: token lifetime is set in the auth plugin — there is no JWT_EXPIRES_IN var.

# ── M-Pesa Daraja ─────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
# Public HTTPS callback on the Render backend. Routes are mounted under /v1.
MPESA_CALLBACK_URL=https://your-render-app.onrender.com/v1/payments/mpesa/callback
MPESA_ENV=sandbox

# ── Africa's Talking (SMS) ────────────────────────────────────
AT_API_KEY=your_at_api_key
AT_USERNAME=makazihub
AT_SENDER_ID=MakaziHub

# ── Cloudinary (images / ID docs) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Redis (Upstash — BullMQ jobs) ─────────────────────────────
REDIS_URL=rediss://your_upstash_redis_url

# ── Resend (email OTP + notifications) ────────────────────────
RESEND_API_KEY=your_resend_api_key
# Code reads EMAIL_FROM (not RESEND_FROM_EMAIL). Defaults if omitted.
EMAIL_FROM=MakaziHub <noreply@makazihub.co.ke>

# ── Feature flags ─────────────────────────────────────────────
FEATURE_ESCROW=false

# ── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.makazihub.co.ke/v1
FRONTEND_URL=https://www.makazihub.co.ke
LOG_LEVEL=info
