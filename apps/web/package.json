{
  "name": "makazihub-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx scripts/generate-snap-routes.ts",
    "build": "vite build",
    "postbuild": "react-snap || true",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "reactSnap": {
    "source": "dist",
    "routes": [
      "/",
      "/listings"
    ],
    "include": [
      "/",
      "/listings",
      "/about",
      "/contact",
      "/estates/kasarani",
      "/estates/ruaka",
      "/estates/westlands",
      "/estates/kilimani",
      "/estates/embakasi",
      "/estates/donholm",
      "/estates/umoja",
      "/estates/githurai",
      "/estates/roysambu",
      "/estates/south-b",
      "/estates/south-c",
      "/estates/ngong-road",
      "/estates/rongai",
      "/estates/thika-road",
      "/estates/kiambu-road",
      "/estates/kikuyu",
      "/estates/kahawa",
      "/estates/zimmerman",
      "/estates/pipeline",
      "/estates/mathare",
      "/estates/pangani",
      "/estates/parklands",
      "/estates/lavington",
      "/estates/karen",
      "/estates/langata",
      "/estates/industrial-area",
      "/estates/eastleigh",
      "/estates/buruburu",
      "/estates/kayole",
      "/estates/komarock"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "inlineCss": true,
    "minifyHtml": {
      "collapseWhitespace": true
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-query": "^5.17.19",
    "axios": "^1.6.5",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.312.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.4",
    "react-hook-form": "^7.49.3",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.21.3",
    "recharts": "^3.8.1",
    "swiper": "^11.0.6",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.17",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.33",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^2.1.9"
  }
}
