# ─────────────────────────────────────────────────────────────
# MakaziHub Web (Vercel) — environment variables
# Only VITE_-prefixed vars are exposed to the browser build.
# ─────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────
# Base URL of the Render backend, including the /v1 prefix.
# Locally this can stay as the dev proxy target below.
VITE_API_BASE_URL=https://your-render-app.onrender.com/v1

# ── SEO / Site ────────────────────────────────────────────────
# Canonical public origin — used for canonical URLs, OG tags, JSON-LD, sitemap.
VITE_SITE_URL=https://www.makazihub.co.ke

# ── Optional / currently unused by the frontend ───────────────
# The web app talks only to the API, not Supabase directly. These are kept for
# reference but are NOT read by any code today (safe to omit).
# VITE_APP_NAME=MakaziHub
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
